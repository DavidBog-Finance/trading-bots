# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret

# Safety switches. Leave these alone until you've paper traded for 3+ months.
ALPACA_PAPER=true
I_UNDERSTAND_LIVE_RISK=no
DRY_RUN=false
KILL_SWITCH=false

# How equity is split (deposits are picked up automatically). Keep the total <= 1.
# Rules bots (backtested):
STOCK_PCT=0.30
CRYPTO_PCT=0.20
OPTIONS_PCT=0.15
# Claude agents (Mac runner only; not backtestable, paper trade first):
AGENT_STOCK_PCT=0.20
AGENT_CRYPTO_PCT=0.15
# Optional dollar caps per bot (0 = none)
STOCK_MAX_USD=0
CRYPTO_MAX_USD=0
OPTIONS_MAX_USD=0

# Stop everything if equity falls this far below what you deposited
MAX_LOSS_PCT=0.35
# Paper accounts have no deposits: set this to your paper starting balance
NET_DEPOSITS_OVERRIDE=1000
MAX_ORDER_PCT=0.60
MIN_TRADE_USD=5

# Stock bot
STOCK_TREND_SYMBOL=SPY
STOCK_MODE=blend
# More trades: add ETFs that pass `python validate.py`, e.g. SPY,QQQ,IWM,DIA
STOCK_RSI2_SYMBOLS=SPY
CASH_SYMBOL=

# Crypto bot. More coins: add ones that pass `python validate.py`, e.g. BTC/USD,ETH/USD
CRYPTO_SYMBOLS=BTC/USD
CRYPTO_TARGET_VOL=0.40
CRYPTO_REBALANCE_BAND=0.10

# Options bot (SPY put credit spreads). Needs Alpaca options Level 3 approval.
OPTIONS_ENABLED=false
OPTIONS_UNDERLYING=SPY
OPTIONS_RISK_PER_TRADE=0.20
OPTIONS_CREDIT_IS_NEGATIVE=true

# iPhone alerts: install the free "ntfy" app, subscribe to a long random topic name, paste it here
NTFY_TOPIC=
# Flow log (learning tool, never trades): send options-flow alerts here from the ntfy app
FLOW_TOPIC=
ALERT_WEBHOOK_URL=
NOTIFY_TRADES=true
FILL_WAIT_SEC=30
DAILY_SUMMARY=false
# Free uptime check (healthchecks.io): pings every 5 min, warns you if the Mac goes offline
HEALTHCHECK_URL=
# Second ntfy topic you PUBLISH to from your iPhone: status, pause, resume, kill, run stock, run crypto.
# Anyone who knows it can pause or sell everything: make it long and random.
CONTROL_TOPIC=

# ---- Claude agents (always-on Mac runner) ----
# pro = use your Claude Pro/Max plan through Claude Code (log in once by running `claude`). No API key.
# api = Claude API, billed per token (needs ANTHROPIC_API_KEY)
CLAUDE_BACKEND=pro
# Path to Claude Code; mac/install.sh fills this in
CLAUDE_BIN=
# Model in pro mode: blank = your plan's default, or opus / sonnet / haiku
CLAUDE_CODE_MODEL=
# The settings below with a $ amount or model name only apply to api mode
ANTHROPIC_API_KEY=
AGENTS_ENABLED=true
# claude-opus-5-5 is the most capable; claude-haiku-5-5 is about 40x cheaper
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
NEWS_MODEL=claude-opus-5-5
NEWS_POLL_MIN=15
NEWS_DAILY_BUDGET_USD=0.75
# Agents and news scoring stop for the day once this is spent
CLAUDE_DAILY_BUDGET_USD=2.00
AGENT_MAX_RUNS_PER_DAY=12
# Hard limits the agents can't override
AGENT_MAX_POSITIONS=6
AGENT_MAX_POSITION_PCT=0.30
AGENT_MAX_ORDERS_PER_DAY=10
AGENT_STOCK_STOP_PCT=0.12
AGENT_CRYPTO_STOP_PCT=0.20
AGENT_SLEEVE_MAX_DD=0.25
AGENT_MIN_PRICE=5
AGENT_MIN_DOLLAR_VOL=20000000
STOCK_SHOCK_PCT=0.05
CRYPTO_SHOCK_PCT=0.08
NEWS_WAKE_MATERIALITY=0.7

# --- Local AI + Claude working together (home server) ---
# Local model screens every headline; Claude gets held-symbol news first, then
# critical/material news, plus a 10% audit sample that keeps the local model honest.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://localhost:11434
LOCAL_MODEL=llama3.1:8b
# Claude calls per hour, shared by priority (agents and held news get all of it,
# audits only 40%) so the plan gets used steadily instead of burning out early
CLAUDE_CALLS_PER_HOUR=30
ESCALATE_MATERIALITY=0.5
AUDIT_SHARE=0.10

# --- Home server extras ---
DATASTORE_ENABLED=true
OPTIONS_RECORDER=true
# New York hours: heavy jobs 12-20 NY = 9am-5pm LA on weekdays; quiet 1-11 NY = 10pm-8am LA
HEAVY_HOURS=12-20
QUIET_HOURS=1-11

# ---- Portfolio 1k options agent (python -m portfolio1k) ----
# Every setting in portfolio1k/settings.py can be overridden with P1K_<NAME>, e.g.:
# P1K_FULL_PORT=true           # bring back full-port (100%) A+ trades; off by default
# P1K_WATCHLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,AVGO
# P1K_FOMC_DAYS=2026-12-09     # Fed decision days (no entries 1:30-2:30 pm New York)
