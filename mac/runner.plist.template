<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <!-- caffeinate -i -s: no idle/system sleep while this runs on the charger -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-s</string>
    <string>__REPO__/.venv/bin/python</string>
    <string>-u</string>
    <string>__REPO__/daemon.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__REPO__/logs/runner.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/runner.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
